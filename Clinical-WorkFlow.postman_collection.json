    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\r\n\r\nif (pm.response.code === 200 && response.accessToken) {\r\n\r\n    // Decode JWT payload\r\n    const tokenParts = response.accessToken.split(\".\");\r\n    const payload = JSON.parse(atob(tokenParts[1]));\r\n\r\n    // Extract role\r\n    const role = payload[\"http://schemas.microsoft.com/ws/2008/06/identity/claims/role\"];\r\n\r\n    console.log(\"Logged in role:\", role);\r\n\r\n    // Save token based on role\r\n    if (role === \"Doctor\") {\r\n        pm.environment.set(\"doctor_token\", response.accessToken);\r\n        console.log(\"Doctor token saved successfully\");\r\n    }\r\n    else if (role === \"Admin\") {\r\n        pm.environment.set(\"admin_token\", response.accessToken);\r\n        console.log(\"Admin token saved successfully\");\r\n    }\r\n    else {\r\n        console.log(\"Unknown role:\", role);\r\n    }\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"doctor@gmail.com\",\r\n  \"password\": \"doctor@123\"\r\n\r\n    // \"email\": \"admin@gmail.com\",\r\n    // \"password\": \"admin@123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
